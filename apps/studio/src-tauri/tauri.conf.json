{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RHIS Studio",
  "mainBinaryName": "rhis-studio",
  "version": "../package.json",
  "identifier": "nl.rhis.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RHIS Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RHIS",
    "copyright": "© RHIS",
    "category": "Music",
    "shortDescription": "Studio client for Hosted Radio Station",
    "longDescription": "Live assist, live broadcasting from your sound card or mixing desk, and a cart wall for Hosted Radio Station.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Dutch"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
