#!/usr/bin/env bash
# Brings the system in line with the stations in the panel. Started as root by hosted-radio-streams-apply.path when
# the API drops run/streams-request.json, and every hour by the timer. Reads run/streams-state.json (written by the
# API) and:
#   - starts, stops and restarts the Icecast server of each station (hosted-radio-icecast@<id>)
#   - writes the web server routes /listen/<station>/<mount> and reloads Caddy
#   - fetches certificates for encoder TLS and FTPS from Caddy into /var/lib/hosted-radio/certs
#   - restarts or stops file upload (SFTPGo) when its settings changed
#   - starts, stops and restarts the AutoDJ player (Liquidsoap) of each Radio station (hosted-radio-autodj@<id>)
#   - mounts the SMB and NFS music shares of Radio stations read-only under stations/<id>/sources/<source>
# Everything in the state file ends up in root-run configuration, so it is validated strictly. Safe to run repeatedly.
set -Eeuo pipefail

main() {
  local DATA=/var/lib/hosted-radio RUN=/var/lib/hosted-radio/run
  local STATE="$RUN/streams-state.json" APPLIED="$RUN/streams-applied.json" STATUS="$RUN/streams-apply-status.json" LOG="$RUN/streams.log"
  local ROUTES=/etc/caddy/hosted-radio-streams.caddy CERTS="$DATA/certs" CADDY_CERTS=/var/lib/caddy/.local/share/caddy/certificates
  local id
  id=$(jq -r '.id // empty' "$RUN/streams-request.json" 2>/dev/null | tr -cd 'A-Za-z0-9-' | cut -c1-64 || true)
  rm -f "$RUN/streams-request.json"
  [[ -f "$STATE" ]] || exit 0

  : > "$LOG"; chown hosted-radio: "$LOG"
  log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG"; }
  status() {
    jq -n --arg id "$id" --arg state "$1" --arg message "$2" --arg t "$(date -Is)" \
      '{id:$id, state:$state, message:$message, startedAt:$t} + (if $state == "running" then {} else {finishedAt:$t} end)' > "$STATUS.tmp"
    chown hosted-radio: "$STATUS.tmp"; mv "$STATUS.tmp" "$STATUS"
  }
  status running "Applying"
  local problems=0
  local uuid_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' slug_re='^[a-z0-9]([a-z0-9-]{0,46}[a-z0-9])?$'
  local host_re='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$' mount_re='^/[A-Za-z0-9][A-Za-z0-9._-]{0,62}$'
  valid_port() { [[ "$1" =~ ^[0-9]{1,5}$ && $1 -ge 1024 && $1 -le 65535 ]]; }

  # 1. Icecast servers.
  local sid port enabled prev_port unit want=()
  while IFS=$'\t' read -r sid port enabled; do
    [[ "$sid" =~ $uuid_re ]] && valid_port "$port" || { log "Skipping invalid station entry"; problems=1; continue; }
    unit="hosted-radio-icecast@$sid.service"
    if [[ "$enabled" == true && -f "$DATA/stations/$sid/icecast.xml" ]]; then
      want+=("$sid")
      prev_port=$(jq -r --arg id "$sid" '.ports[$id] // empty' "$APPLIED" 2>/dev/null || true)
      if ! systemctl is-active --quiet "$unit"; then
        log "Starting the server of station $sid (port $port)"
        systemctl enable --quiet "$unit" 2>>"$LOG" || true
        systemctl start "$unit" >>"$LOG" 2>&1 || { log "Station $sid did not start: $(journalctl -u "$unit" -n 3 --no-pager -o cat 2>/dev/null | tr '\n' ' ')"; problems=1; }
      elif [[ -n "$prev_port" && "$prev_port" != "$port" ]]; then
        log "Restarting station $sid for its new port $port"
        systemctl restart "$unit" >>"$LOG" 2>&1 || problems=1
      fi
    elif systemctl is-enabled --quiet "$unit" 2>/dev/null || systemctl is-active --quiet "$unit"; then
      log "Stopping the server of station $sid"
      systemctl disable --now --quiet "$unit" >>"$LOG" 2>&1 || true
    fi
  done < <(jq -r '.stations[] | [.id, (.port|tostring), (.enabled|tostring)] | @tsv' "$STATE")
  # Servers of deleted stations.
  local running
  while read -r unit; do
    [[ -z "$unit" ]] && continue
    running=${unit#hosted-radio-icecast@}; running=${running%.service}
    if [[ " ${want[*]-} " != *" $running "* ]] && { systemctl is-active --quiet "$unit" || systemctl is-enabled --quiet "$unit" 2>/dev/null; }; then
      log "Stopping the server of station $running, which is no longer active"
      systemctl disable --now --quiet "$unit" >>"$LOG" 2>&1 || true
    fi
  done < <(systemctl list-units --all --plain --no-legend 'hosted-radio-icecast@*.service' 2>/dev/null | awk '{print $1}'; \
           systemctl list-unit-files --plain --no-legend 'hosted-radio-icecast@*.service' 2>/dev/null | awk '$1 ~ /@.+\.service/ {print $1}')

  # 2. Web server routes for listeners.
  local tmp slug m
  tmp=$(mktemp)
  echo "# Managed by Hosted Radio Station (stations in the panel). Manual changes are overwritten." > "$tmp"
  while IFS=$'\t' read -r slug port m; do
    [[ "$slug" =~ $slug_re && "$m" =~ $mount_re ]] && valid_port "$port" || { log "Skipping invalid listen route"; problems=1; continue; }
    # X-Hrs-Client carries the listener's real address (behind trusted proxies too) to the statistics hooks.
    printf 'handle /listen/%s%s {\n\trewrite * %s\n\treverse_proxy 127.0.0.1:%s {\n\t\theader_up X-Hrs-Client {client_ip}\n\t\theader_up -X-Hrs-Via\n\t\tflush_interval -1\n\t}\n}\n' "$slug" "$m" "$m" "$port" >> "$tmp"
  done < <(jq -r '.listen[] | .slug as $s | .port as $p | .mounts[] | [$s, ($p|tostring), .] | @tsv' "$STATE")
  local included=0
  grep -q 'hosted-radio-streams.caddy' /etc/caddy/Caddyfile 2>/dev/null && included=1
  if ! cmp -s "$tmp" "$ROUTES"; then
    install -m 0644 "$tmp" "$ROUTES"
    if [[ $included -eq 1 ]]; then
      log "Listen routes changed, reloading the web server"
      systemctl reload caddy >>"$LOG" 2>&1 || { log "Reloading Caddy failed"; problems=1; }
    fi
  fi
  if [[ $included -eq 0 ]]; then
    log "The web server configuration does not include the listen routes yet: apply it once under Web server"
    problems=1
  fi
  rm -f "$tmp"

  # 3. Certificates for TLS encoders and FTPS, from Caddy's store. Missing ones are requested by asking Caddy for the
  #    name once (on-demand TLS; Caddy only issues for names the API approves).
  install -d -m 0750 -o hosted-radio -g hosted-radio "$CERTS"
  local h crt changed_default=0
  copy_cert() { # copy_cert <host> <target name>
    local src
    src=$(find "$CADDY_CERTS" -type f -path "*/$1/$1.crt" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)
    [[ -n "$src" && -f "${src%.crt}.key" ]] || return 1
    if ! cmp -s "$src" "$CERTS/$2.crt"; then
      install -m 0640 -o hosted-radio -g hosted-radio "$src" "$CERTS/$2.crt"
      install -m 0600 -o hosted-radio -g hosted-radio "${src%.crt}.key" "$CERTS/$2.key"
      log "Certificate for $1 updated"
      [[ "$2" == default ]] && changed_default=1
    fi
    return 0
  }
  while read -r h; do
    [[ -z "$h" ]] && continue
    [[ "$h" =~ $host_re ]] || { log "Skipping invalid host name"; continue; }
    if ! copy_cert "$h" "$h"; then
      log "Requesting a certificate for $h"
      curl -sk --max-time 90 --resolve "$h:443:127.0.0.1" "https://$h/" -o /dev/null 2>>"$LOG" || true
      copy_cert "$h" "$h" || log "No certificate for $h yet (does its DNS point to this server?)"
    fi
  done < <(jq -r '.certHosts[]?' "$STATE")
  local dh
  dh=$(jq -r '.defaultCertHost // empty' "$STATE")
  if [[ -n "$dh" && "$dh" =~ $host_re ]] && copy_cert "$dh" default; then
    :
  elif [[ ! -f "$CERTS/default.crt" ]] || ! openssl x509 -checkend 86400 -noout -in "$CERTS/default.crt" >/dev/null 2>&1; then
    # No domain (yet): a self-signed certificate keeps TLS working for encoders that accept it.
    log "Creating a self-signed certificate for encoders and FTPS"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 825 -subj "/CN=$(hostname -f 2>/dev/null || hostname)" \
      -keyout "$CERTS/default.key" -out "$CERTS/default.crt" >/dev/null 2>&1
    chown hosted-radio:hosted-radio "$CERTS/default.key" "$CERTS/default.crt"
    chmod 0600 "$CERTS/default.key"; chmod 0640 "$CERTS/default.crt"
    changed_default=1
  fi

  # 4. File upload.
  local sftp_on sftp_hash prev_hash
  sftp_on=$(jq -r '.sftpgo.enabled' "$STATE")
  sftp_hash=$(jq -r '.sftpgo.hash' "$STATE" | tr -cd 'a-f0-9')
  prev_hash=$(jq -r '.sftpgo // empty' "$APPLIED" 2>/dev/null || true)
  if [[ "$sftp_on" == true && -x /usr/bin/sftpgo && -f "$DATA/sftpgo/sftpgo.env" ]]; then
    if ! systemctl is-active --quiet hosted-radio-sftpgo; then
      log "Starting file upload (SFTPGo)"
      systemctl enable --quiet hosted-radio-sftpgo 2>>"$LOG" || true
      systemctl start hosted-radio-sftpgo >>"$LOG" 2>&1 || { log "SFTPGo did not start, see: journalctl -u hosted-radio-sftpgo"; problems=1; }
    elif [[ "$sftp_hash" != "$prev_hash" ]]; then
      log "Upload settings changed, restarting SFTPGo"
      systemctl restart hosted-radio-sftpgo >>"$LOG" 2>&1 || problems=1
    elif [[ $changed_default -eq 1 ]]; then
      systemctl reload hosted-radio-sftpgo >>"$LOG" 2>&1 || true
    fi
  elif systemctl is-active --quiet hosted-radio-sftpgo; then
    log "File upload is switched off, stopping SFTPGo"
    systemctl disable --now --quiet hosted-radio-sftpgo >>"$LOG" 2>&1 || true
  fi

  # 5. Music shares of Radio stations, mounted read-only for the library and the AutoDJ. Done before the players start,
  #    so a player that starts finds its files.
  local mstatus="$RUN/media-mounts-status.json" mjson='{}' mid msid mtype mhost mpath mver mcred target opts err src mounted=()
  local mhost_re='^[a-z0-9]([a-z0-9.-]{0,252}[a-z0-9])?$' share_re='^[A-Za-z0-9._$ -]{1,80}(/[A-Za-z0-9._ -]{1,80}){0,8}$'
  local export_re='^/[A-Za-z0-9._/-]{0,200}$' ver_re='^(|1\.0|2\.0|2\.1|3\.0|3\.1\.1|3|4|4\.1|4\.2)$'
  mount_result() { mjson=$(jq --arg id "$1" --argjson ok "$2" --arg m "$3" --arg t "$(date -Is)" '. + {($id): {ok: $ok, message: $m, at: $t}}' <<<"$mjson"); }
  while IFS=$'\t' read -r mid msid mtype mhost mpath mver mcred; do
    [[ "$mid" =~ $uuid_re && "$msid" =~ $uuid_re && "$mhost" =~ $mhost_re && "$mver" =~ $ver_re ]] || { log "Skipping invalid share entry"; problems=1; continue; }
    if [[ "$mtype" == smb ]]; then [[ "$mpath" =~ $share_re ]] || { log "Skipping invalid SMB share"; problems=1; continue; }
    elif [[ "$mtype" == nfs ]]; then [[ "$mpath" =~ $export_re ]] || { log "Skipping invalid NFS export"; problems=1; continue; }
    else continue; fi
    [[ -d "$DATA/stations/$msid" ]] || continue
    target="$DATA/stations/$msid/sources/$mid"
    mounted+=("$target")
    if mountpoint -q "$target" 2>/dev/null; then mount_result "$mid" true "Mounted"; continue; fi
    if [[ "$mtype" == smb ]] && ! command -v mount.cifs >/dev/null; then
      log "Installing SMB support (cifs-utils)"
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq cifs-utils >>"$LOG" 2>&1 || true
    elif [[ "$mtype" == nfs ]] && ! command -v mount.nfs >/dev/null; then
      log "Installing NFS support (nfs-common)"
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nfs-common >>"$LOG" 2>&1 || true
    fi
    install -d -m 0755 -o hosted-radio -g hosted-radio "$DATA/stations/$msid/sources" "$target"
    if [[ "$mtype" == smb ]]; then
      opts="ro,nosuid,nodev,noexec,noserverino,uid=$(id -u hosted-radio),gid=$(id -g hosted-radio),file_mode=0444,dir_mode=0555"
      [[ -n "$mver" ]] && opts+=",vers=$mver"
      src="$RUN/media-credentials/$mid"
      if [[ "$mcred" == true && -f "$src" && ! -L "$src" ]]; then
        install -d -m 0700 /run/hosted-radio-cifs
        install -m 0600 "$src" "/run/hosted-radio-cifs/$mid"
        opts+=",credentials=/run/hosted-radio-cifs/$mid"
      else
        opts+=",guest"
      fi
      log "Mounting //$mhost/$mpath for station $msid"
      err=$(timeout 40 mount -t cifs "//$mhost/$mpath" "$target" -o "$opts" 2>&1) || true
    else
      opts="ro,nosuid,nodev,noexec,soft,timeo=100,retrans=2"
      [[ -n "$mver" ]] && opts+=",vers=$mver"
      log "Mounting $mhost:$mpath for station $msid"
      err=$(timeout 40 mount -t nfs "$mhost:$mpath" "$target" -o "$opts" 2>&1) || true
    fi
    if mountpoint -q "$target" 2>/dev/null; then
      mount_result "$mid" true "Mounted"
    else
      err=$(tr '\n' ' ' <<<"$err" | cut -c1-300)
      if [[ "$err" == *"ermission denied"* || "$err" == *"not permitted"* || "$err" == *"must be superuser"* ]] && [[ "$err" != *"error(13)"* ]] && systemd-detect-virt -cq 2>/dev/null; then
        err="This container may not mount network shares ($err). In Proxmox, enable the SMB/CIFS or NFS feature of the container, or mount the share on the host, pass it in as a bind mount and add it as a server folder."
      fi
      log "Mounting share $mid failed: $err"
      mount_result "$mid" false "${err:-Mounting failed}"
      problems=1
    fi
  done < <(jq -r '.mediaMounts[]? | [.id, .stationId, .type, .host, .path, .version, (.credentials|tostring)] | @tsv' "$STATE")
  # Shares that were removed or switched off.
  while read -r target; do
    [[ -z "$target" ]] && continue
    if [[ " ${mounted[*]-} " != *" $target "* ]]; then
      log "Unmounting $target"
      umount -l "$target" >>"$LOG" 2>&1 || true
      rm -f "/run/hosted-radio-cifs/$(basename "$target")"
    fi
  done < <(findmnt -rn -o TARGET 2>/dev/null | grep -E "^$DATA/stations/[0-9a-f-]{36}/sources/[0-9a-f-]{36}$" || true)
  jq . <<<"$mjson" > "$mstatus.tmp" && chown hosted-radio: "$mstatus.tmp" && mv "$mstatus.tmp" "$mstatus"

  # 6. AutoDJ players. A new script hash (settings changed) restarts the player.
  local aid ahash prev_ahash awant=()
  while IFS=$'\t' read -r aid ahash; do
    [[ "$aid" =~ $uuid_re && "$ahash" =~ ^[a-f0-9]{16}$ ]] || { log "Skipping invalid AutoDJ entry"; problems=1; continue; }
    [[ -f "$DATA/stations/$aid/autodj.liq" ]] || continue
    if ! command -v liquidsoap >/dev/null; then
      log "Liquidsoap is not installed; run an update (hrs update) to install it"; problems=1; break
    fi
    awant+=("$aid")
    unit="hosted-radio-autodj@$aid.service"
    prev_ahash=$(jq -r --arg id "$aid" '.autodj[$id] // empty' "$APPLIED" 2>/dev/null || true)
    if ! systemctl is-active --quiet "$unit"; then
      log "Starting the AutoDJ of station $aid"
      systemctl enable --quiet "$unit" 2>>"$LOG" || true
      systemctl start "$unit" >>"$LOG" 2>&1 || { log "The AutoDJ of station $aid did not start: $(journalctl -u "$unit" -n 3 --no-pager -o cat 2>/dev/null | tr '\n' ' ')"; problems=1; }
    elif [[ "$prev_ahash" != "$ahash" ]]; then
      log "AutoDJ settings of station $aid changed, restarting its player"
      systemctl restart "$unit" >>"$LOG" 2>&1 || problems=1
    fi
  done < <(jq -r '.autodj[]? | [.id, .hash] | @tsv' "$STATE")
  while read -r unit; do
    [[ -z "$unit" ]] && continue
    running=${unit#hosted-radio-autodj@}; running=${running%.service}
    if [[ " ${awant[*]-} " != *" $running "* ]] && { systemctl is-active --quiet "$unit" || systemctl is-enabled --quiet "$unit" 2>/dev/null; }; then
      log "Stopping the AutoDJ of station $running"
      systemctl disable --now --quiet "$unit" >>"$LOG" 2>&1 || true
    fi
  done < <(systemctl list-units --all --plain --no-legend 'hosted-radio-autodj@*.service' 2>/dev/null | awk '{print $1}'; \
           systemctl list-unit-files --plain --no-legend 'hosted-radio-autodj@*.service' 2>/dev/null | awk '$1 ~ /@.+\.service/ {print $1}')

  # Remember what was applied, to detect port, upload and AutoDJ changes next time.
  jq '{ports: (.stations | map({(.id): .port}) | add // {}), sftpgo: .sftpgo.hash, autodj: ((.autodj // []) | map({(.id): .hash}) | add // {})}' "$STATE" > "$APPLIED.tmp" && mv "$APPLIED.tmp" "$APPLIED"
  local n
  n=$(jq '[.stations[] | select(.enabled)] | length' "$STATE")
  local players=""
  [[ ${#awant[@]} -gt 0 ]] && players=", ${#awant[@]} AutoDJ player(s)"
  if [[ $problems -eq 0 ]]; then status succeeded "$n station server(s) running$players."; else status failed "Some changes failed, see the log."; fi
  log "Done."
}

main "$@"; exit $?
