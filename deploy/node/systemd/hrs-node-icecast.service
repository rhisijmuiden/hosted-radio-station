[Unit]
Description=Hosted Radio Station node: Icecast server for relayed streams
After=network-online.target
ConditionPathExists=/var/lib/hrs-node/icecast/icecast.xml

[Service]
Type=simple
User=hrs-node
Group=hrs-node
ExecStart=/usr/bin/icecast2 -c /var/lib/hrs-node/icecast/icecast.xml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
