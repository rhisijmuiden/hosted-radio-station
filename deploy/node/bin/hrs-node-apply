#!/usr/bin/env bash
# Root helper of a node. Started by hrs-node-apply.path when the agent drops run/apply-request.json, and by a timer.
# Reads run/apply-state.json (written by the agent) and:
#   - starts Icecast for the relayed streams, and restarts it when its port changed
#   - writes the web server configuration (Caddy) for listeners: HTTPS on the node's host name, plain HTTP on a port
#   - fetches certificates for the node's host name and customer encoder names into /var/lib/hrs-node/certs
# Everything in the state file ends up in root-run configuration, so it is validated strictly. Safe to run repeatedly.
set -Eeuo pipefail

main() {
  local DATA=/var/lib/hrs-node RUN=/var/lib/hrs-node/run
  local STATE="$RUN/apply-state.json" APPLIED="$RUN/apply-applied.json" STATUS="$RUN/apply-status.json" LOG="$RUN/apply.log"
  local CERTS="$DATA/certs" CADDY_CERTS=/var/lib/caddy/.local/share/caddy/certificates CADDYFILE=/etc/caddy/Caddyfile
  local id
  id=$(jq -r '.id // empty' "$RUN/apply-request.json" 2>/dev/null | tr -cd 'A-Za-z0-9-' | cut -c1-64 || true)
  rm -f "$RUN/apply-request.json"
  [[ -f "$STATE" ]] || exit 0

  : > "$LOG"; chown hrs-node: "$LOG"
  log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG"; }
  local problems=()
  status() { # status <state> <message>
    local p='[]'
    [[ ${#problems[@]} -gt 0 ]] && p=$(printf '%s\n' "${problems[@]}" | jq -R . | jq -s .)
    jq -n --arg id "$id" --arg state "$1" --arg message "$2" --arg t "$(date -Is)" --argjson problems "$p" \
      '{id:$id, state:$state, message:$message, problems:$problems, at:$t}' > "$STATUS.tmp"
    chown hrs-node: "$STATUS.tmp"; mv "$STATUS.tmp" "$STATUS"
  }
  status running "Applying"
  local host_re='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
  valid_port() { [[ "$1" =~ ^[0-9]{1,5}$ && $1 -ge 1 && $1 -le 65535 ]]; }

  local web public_host listen_port ice_port ice_bind
  web=$(jq -r '.web' "$STATE"); public_host=$(jq -r '.publicHost // empty' "$STATE")
  listen_port=$(jq -r '.listenPort' "$STATE"); ice_port=$(jq -r '.icecastPort' "$STATE"); ice_bind=$(jq -r '.icecastBind' "$STATE")
  [[ "$web" =~ ^(caddy|direct)$ ]] || { problems+=("Invalid web mode"); status failed "Invalid state"; exit 1; }
  [[ -z "$public_host" || "$public_host" =~ $host_re ]] || { problems+=("Invalid host name"); public_host=""; }
  valid_port "$listen_port" && valid_port "$ice_port" || { problems+=("Invalid port"); status failed "Invalid state"; exit 1; }
  [[ "$ice_bind" =~ ^(127\.0\.0\.1|0\.0\.0\.0)$ ]] || { problems+=("Invalid bind address"); status failed "Invalid state"; exit 1; }
  [[ "$web" == direct && "$ice_port" -lt 1024 ]] && problems+=("Icecast cannot listen on port $ice_port without a web server; choose a port of 1024 or higher")

  # 1. Icecast.
  local prev_layout new_layout
  prev_layout=$(jq -r '"\(.icecastBind):\(.icecastPort)"' "$APPLIED" 2>/dev/null || true)
  new_layout="$ice_bind:$ice_port"
  if [[ -f "$DATA/icecast/icecast.xml" ]]; then
    install -d -m 0750 -o hrs-node -g hrs-node "$DATA/icecast/logs"
    if [[ "$prev_layout" != "$new_layout" ]] || ! systemctl is-active --quiet hrs-node-icecast; then
      log "Starting Icecast on $new_layout"
      systemctl enable --quiet hrs-node-icecast 2>/dev/null || true
      systemctl restart hrs-node-icecast >> "$LOG" 2>&1 || problems+=("Icecast did not start (port $ice_port in use?)")
    fi
  fi

  # 2. Web server.
  local cert_hosts=() h
  while read -r h; do
    [[ -z "$h" ]] && continue
    [[ "$h" =~ $host_re ]] && cert_hosts+=("$h") || log "Skipping invalid host name"
  done < <(jq -r '.certHosts[]?' "$STATE")
  if [[ "$web" == caddy ]]; then
    if [[ ! -x /usr/bin/caddy ]]; then
      problems+=("Caddy is not installed")
    elif [[ -f "$CADDYFILE" ]] && grep -q 'Managed by Hosted Radio Station (Settings' "$CADDYFILE"; then
      # The main server on the same machine owns the web server.
      problems+=("The web server belongs to the main server on this machine; install the node with --no-caddy")
    else
      local tmp site
      tmp=$(mktemp)
      {
        echo "# Managed by the Hosted Radio Station node agent. Manual changes are overwritten."
        printf '\n(listen) {\n\thandle /listen/* {\n\t\treverse_proxy 127.0.0.1:%s {\n\t\t\theader_up X-Hrs-Client {client_ip}\n\t\t\tflush_interval -1\n\t\t}\n\t}\n\thandle {\n\t\trespond "Hosted Radio Station node" 200\n\t}\n}\n' "$ice_port"
        [[ -n "$public_host" ]] && printf '\n%s {\n\timport listen\n}\n' "$public_host"
        if [[ "$listen_port" == 80 ]]; then site='http://'; else site="http://:$listen_port"; fi
        printf '\n%s {\n\timport listen\n}\n' "$site"
        # Encoder names of customers only need a certificate; the agent takes the encoders on its own ports.
        for h in "${cert_hosts[@]}"; do
          [[ "$h" == "$public_host" ]] && continue
          printf '\n%s {\n\trespond 204\n}\n' "$h"
        done
      } > "$tmp"
      if ! cmp -s "$tmp" "$CADDYFILE"; then
        if caddy validate --adapter caddyfile --config "$tmp" >> "$LOG" 2>&1; then
          install -m 0644 "$tmp" "$CADDYFILE"
          log "Web server configuration changed, reloading"
          systemctl reload caddy >> "$LOG" 2>&1 || systemctl restart caddy >> "$LOG" 2>&1 || problems+=("Reloading the web server failed")
        else
          problems+=("The web server rejected the configuration")
        fi
      fi
      rm -f "$tmp"
    fi
  fi

  # 3. Certificates for encoder TLS, from Caddy's store. A self-signed one until there is a real one.
  install -d -m 0750 -o hrs-node -g hrs-node "$CERTS"
  copy_cert() { # copy_cert <host> <target name>
    local src
    src=$(find "$CADDY_CERTS" -type f -path "*/$1/$1.crt" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)
    [[ -n "$src" && -f "${src%.crt}.key" ]] || return 1
    if ! cmp -s "$src" "$CERTS/$2.crt"; then
      install -m 0640 -o hrs-node -g hrs-node "$src" "$CERTS/$2.crt"
      install -m 0600 -o hrs-node -g hrs-node "${src%.crt}.key" "$CERTS/$2.key"
      log "Certificate for $1 updated"
    fi
  }
  for h in "${cert_hosts[@]}"; do
    if ! copy_cert "$h" "$h"; then
      curl -sk --max-time 60 --resolve "$h:443:127.0.0.1" "https://$h/" -o /dev/null 2>>"$LOG" || true
      copy_cert "$h" "$h" || log "No certificate for $h yet (does its DNS point to this node?)"
    fi
  done
  if [[ -n "$public_host" ]] && copy_cert "$public_host" default; then
    :
  elif [[ ! -f "$CERTS/default.crt" ]] || ! openssl x509 -checkend 86400 -noout -in "$CERTS/default.crt" >/dev/null 2>&1; then
    log "Creating a self-signed certificate for encoders"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 825 -subj "/CN=$(hostname -f 2>/dev/null || hostname)" \
      -keyout "$CERTS/default.key" -out "$CERTS/default.crt" >/dev/null 2>&1
    chown hrs-node:hrs-node "$CERTS/default.key" "$CERTS/default.crt"
    chmod 0600 "$CERTS/default.key"; chmod 0640 "$CERTS/default.crt"
  fi

  cp "$STATE" "$APPLIED"
  if [[ ${#problems[@]} -gt 0 ]]; then status failed "${problems[0]}"; else status succeeded "Applied"; fi
}

main "$@"
